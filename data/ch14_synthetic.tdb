$ Original educational model; NOT a Cu-Ni assessment.
ELEMENT CU FCC_A1 63.546 0 0 !
ELEMENT NI FCC_A1 58.6934 0 0 !
TYPE_DEFINITION % SEQ * !
PHASE ALPHA % 1 1 !
CONSTITUENT ALPHA :CU,NI: !
PARAMETER G(ALPHA,CU;0) 298.15 0; 3000 N !
PARAMETER G(ALPHA,NI;0) 298.15 6000; 3000 N !
PHASE BETA % 1 1 !
CONSTITUENT BETA :CU,NI: !
PARAMETER G(BETA,CU;0) 298.15 6000; 3000 N !
PARAMETER G(BETA,NI;0) 298.15 0; 3000 N !
PHASE GAMMA % 1 1 !
CONSTITUENT GAMMA :CU,NI: !
PARAMETER G(GAMMA,CU;0) 298.15 -5000; 3000 N !
PARAMETER G(GAMMA,NI;0) 298.15 -5000; 3000 N !
PHASE DELTA % 1 1 !
CONSTITUENT DELTA :CU,NI: !
PARAMETER G(DELTA,CU;0) 298.15 0; 3000 N !
PARAMETER G(DELTA,NI;0) 298.15 0; 3000 N !
PARAMETER L(DELTA,CU,NI;0) 298.15 12000; 3000 N !
